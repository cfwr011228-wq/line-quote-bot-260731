# LINE Developers Console > Messaging API 頁籤取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Google 服務帳戶金鑰檔路徑(見 README 說明)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# 目標試算表 ID(網址中 /d/ 和 /edit 之間那串英數字)
SPREADSHEET_ID=

# 圖片要上傳到的 Google Drive 資料夾 ID(選填,不填則上傳到服務帳戶的根目錄)
DRIVE_FOLDER_ID=

# 試算表分頁名稱
SHEET_NAME=報價紀錄

# 固定運費(每公斤)與關稅(每公斤),依你的實際費率調整
SHIPPING_RATE_PER_KG=100
TARIFF_RATE_PER_KG=20

PORT=3000
